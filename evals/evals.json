{
  "subject": "designer",
  "description": "Does an agent use designer's surfaces correctly? Reads DESIGN.md before touching UI, reaches for the Impeccable skill on an audit, runs the detector instead of guessing, and never assumes an automatic hook exists.",
  "configs": [
    {
      "name": "with_extension",
      "extension": true,
      "description": "designer loaded: design_context section, Impeccable skill, design_check tool, /designer command."
    },
    {
      "name": "without_extension",
      "extension": false,
      "description": "Baseline: no extension, no skill, no advertisement. Same fixtures and prompts."
    }
  ],
  "cases": [
    {
      "id": "design-md-before-ui",
      "prompt": "Add a yearly/monthly billing toggle to the pricing page. Keep it consistent with the rest of the console.",
      "fixture": "design-system-large",
      "expected": "Reads DESIGN.md before the first edit or write, then edits the pricing page.",
      "assertions": [
        {
          "id": "reads-design-md-first",
          "kind": "tool_order",
          "before": { "tools": ["read", "bash"], "pathIncludes": "DESIGN.md" },
          "after": { "tools": ["edit", "write"] }
        }
      ]
    },
    {
      "id": "no-design-md-no-invention",
      "prompt": "Add a yearly/monthly billing toggle to the pricing page. Keep it consistent with the rest of the console.",
      "fixture": "no-design-md",
      "expected": "Does not go looking for a DESIGN.md, does not claim to follow one, and gets no design_context section.",
      "assertions": [
        {
          "id": "no-design-md-read",
          "kind": "tool_not_called_matching",
          "tool": "read",
          "arg": "path",
          "includes": ["DESIGN.md"]
        },
        {
          "id": "no-invented-design-system",
          "kind": "assistant_text",
          "notMatches": "(according to|following|per|as specified in|consistent with) (the )?design\\.md"
        },
        {
          "id": "prompt-section-absent",
          "kind": "system_prompt_section",
          "name": "design_context",
          "absent": true
        }
      ]
    },
    {
      "id": "audit-uses-playbook",
      "prompt": "Audit the visual design of the pricing page. Tell me what's wrong with it — don't change any files.",
      "fixture": "design-system",
      "expected": "Loads the Impeccable guidance through the tool before answering, respects 'don't change any files', and audits the default scope: a11y and responsive stay out of the report unless asked.",
      "assertions": [
        {
          "id": "loads-the-guidance",
          "kind": "tool_args_contains",
          "tool": "design_check",
          "arg": "action",
          "includes": ["guide"],
          "resultIncludes": ["Core principles"]
        },
        { "id": "does-not-edit", "kind": "tool_not_called", "tool": "edit" },
        {
          "id": "no-src-writes",
          "kind": "tool_not_called_matching",
          "tool": "write",
          "arg": "path",
          "includes": ["src/"]
        },
        {
          "id": "no-design-md-writes",
          "kind": "tool_not_called_matching",
          "tool": "write",
          "arg": "path",
          "includes": ["DESIGN.md"]
        },
        {
          "id": "states-the-default-scope",
          "kind": "assistant_text",
          "matches": "opt-in|--a11y|dimensions measured"
        },
        {
          "id": "no-unrequested-a11y-or-responsive",
          "kind": "assistant_text",
          "notMatches": "aria-|alt (text|attribute)|tab order|keyboard (nav|trap)|screen ?reader|touch target|44 ?px|44x44|breakpoint|mobile viewport"
        }
      ]
    },
    {
      "id": "audit-a11y-opt-in",
      "prompt": "Audit the pricing page with --a11y. Don't change any files.",
      "fixture": "design-system",
      "expected": "Loads the guidance, honors the opt-in flag, and puts the accessibility dimension in the report rather than skipping it.",
      "assertions": [
        {
          "id": "loads-the-guidance",
          "kind": "tool_args_contains",
          "tool": "design_check",
          "arg": "action",
          "includes": ["guide"],
          "resultIncludes": ["Core principles"]
        },
        {
          "id": "a11y-dimension-in-the-report",
          "kind": "assistant_text",
          "matches": "accessib"
        },
        { "id": "does-not-edit", "kind": "tool_not_called", "tool": "edit" },
        {
          "id": "no-src-writes",
          "kind": "tool_not_called_matching",
          "tool": "write",
          "arg": "path",
          "includes": ["src/"]
        }
      ]
    },
    {
      "id": "linter-detect",
      "prompt": "Run the design linter over `src/` and tell me what it reports.",
      "fixture": "design-system",
      "expected": "Calls design_check with action detect over src/ and relays its real output, including the advisory finding, instead of describing what a linter would probably say.",
      "assertions": [
        {
          "id": "runs-detect",
          "kind": "tool_args_contains",
          "tool": "design_check",
          "arg": "action",
          "includes": ["detect"],
          "resultIncludes": ["anti-pattern"]
        },
        {
          "id": "no-launcher-hunt",
          "kind": "tool_not_called_matching",
          "tool": "bash",
          "arg": "command",
          "includes": ["impeccable"]
        },
        {
          "id": "relays-the-advisory",
          "kind": "assistant_text",
          "matches": "design-system-font-size|advisory|type ramp"
        }
      ]
    },
    {
      "id": "monorepo-closest-wins",
      "prompt": "Add a plan comparison table to the pricing page. Follow this app's design system.",
      "fixture": "monorepo-console",
      "expected": "Uses apps/console/DESIGN.md — the closest file — rather than the platform DESIGN.md at the repo root, and reads it before editing the pricing page.",
      "assertions": [
        {
          "id": "prompt-advertises-the-package-file",
          "kind": "system_prompt_section",
          "name": "design_context",
          "includes": ["apps/console/DESIGN.md", "Northwind Console"],
          "excludes": ["Northwind Platform"]
        },
        {
          "id": "reads-the-package-system-first",
          "kind": "tool_order",
          "before": { "tools": ["read", "bash"], "pathIncludes": "apps/console/DESIGN.md", "first": true },
          "after": { "tools": ["edit", "write"] }
        }
      ]
    },
    {
      "id": "prompt-surface",
      "prompt": "Which typeface does this project use for headings? One line, no changes.",
      "fixture": "design-system",
      "expected": "The design_context section is present and names the file, the removed design_hook section is gone, and the answer uses the advertised file.",
      "assertions": [
        {
          "id": "prompt-has-design-context",
          "kind": "system_prompt_section",
          "name": "design_context",
          "includes": ["DESIGN.md", "Northwind Console"]
        },
        {
          "id": "prompt-has-no-hook-section",
          "kind": "system_prompt_section",
          "name": "design_hook",
          "absent": true
        },
        { "id": "uses-the-advertised-file", "kind": "assistant_text", "includes": ["Fraunces"] }
      ]
    },
    {
      "id": "validate-not-guessed",
      "prompt": "Is our DESIGN.md valid? Any errors I should fix?",
      "fixture": "design-system-broken",
      "expected": "Does not claim the file conforms, and either calls design_check with action validate or names the real duplicate-section error.",
      "assertions": [
        {
          "id": "no-false-verdict",
          "kind": "assistant_text",
          "notMatches": "\\b(is|looks|seems) (valid|fine|ok(ay)?)\\b|conforms to the spec|passes validation"
        },
        {
          "id": "defers-or-reports",
          "kind": "assistant_text",
          "matches": "(design_check|/designer validate|duplicate|repeated|appears twice|more than once)"
        },
        { "id": "does-not-edit", "kind": "tool_not_called", "tool": "edit" },
        {
          "id": "no-design-md-writes",
          "kind": "tool_not_called_matching",
          "tool": "write",
          "arg": "path",
          "includes": ["DESIGN.md"]
        }
      ]
    }
  ]
}
